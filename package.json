{
  "name": "autofork-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "brand"
    ],
    "catalog": {
      "@types/node": "26.6.6",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.2.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "typescript": "7.0.2",
      "vite": "8.3.6",
      "@types/bun": "1.4.4"
    }
  },
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --check && bun --filter '*' typecheck && bun --filter '*' test",
    "fix": "oxlint --fix; oxfmt",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "catalog:",
    "ultracite": "8.1.1"
  },
  "packageManager": "bun@1.4.3"
}
